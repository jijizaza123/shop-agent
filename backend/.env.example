# ============================================================================
#  .env.example —— 复制成 .env 再填真实值 (backend/.env 已在 .gitignore)
#  用法: copy .env.example .env   (Windows: copy .env.example .env)
# ============================================================================

# ---- 数据库 (Postgres) ----
# 格式: postgresql+psycopg://用户:密码@主机:端口/库名
DATABASE_URL=postgresql+psycopg://postgres:your_password@127.0.0.1:5432/shop_db

# ---- LLM (Agnes, OpenAI 兼容协议) ----
AGNES_API_KEY=your_agnes_api_key
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_MODEL=agnes-3.0-flash

# ---- Agent 行为 ----
AGENT_MAX_TOOL_ROUNDS=5
AGENT_MAX_FALLBACK_RETRIES=3
AGENT_TIMEOUT_SEC=30
